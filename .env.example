# Copy to .env and adjust. Never commit .env.

# --- Required ---------------------------------------------------------------------
TALAIA_DATABASE_URL=postgresql+asyncpg://talaia:changeme@db:5432/talaia

# --- Optional, shown with their defaults -------------------------------------------
# Leave this unset to take the per-environment default: config/monitors.yaml for
# development, and the git-ignored config/monitors.local.yaml in production, which is the
# one that holds real targets. Setting it here overrides both -- which is an easy way to
# deploy the placeholder monitors by accident.
# TALAIA_CONFIG_PATH=/app/config/monitors.local.yaml
TALAIA_LOG_LEVEL=INFO
TALAIA_LOG_FORMAT=json            # json | console
TALAIA_RETENTION_DAYS=30

# Notifications. Leave TALAIA_NTFY_TOPIC empty to disable them.
TALAIA_NTFY_URL=https://ntfy.example.org
TALAIA_NTFY_TOPIC=
TALAIA_NTFY_TOKEN=

# Sessions. Create users with: python -m talaia.auth add <username>
TALAIA_SESSION_TTL_HOURS=720
# Set false for plain-HTTP LAN access; a Secure cookie is never sent over http://.
TALAIA_SESSION_COOKIE_SECURE=true

# Optional. When set, the dashboard shows a Grafana link in its top bar.
TALAIA_GRAFANA_URL=

TALAIA_BASE_URL=http://localhost:9999

# Reported by the talaia_build_info metric. Set from the build argument of the same name.
TALAIA_COMMIT=unknown

# --- Consumed by the postgres container, not by the application --------------------
POSTGRES_USER=talaia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talaia
