# Copy to .env and adjust. Never commit .env.

# --- Required in production -------------------------------------------------------
# Which image to run. compose.prod.yaml refuses to start without TALAIA_IMAGE.
TALAIA_IMAGE=ghcr.io/OWNER/talaia   # no tag here
TALAIA_TAG=v1.3.0
POSTGRES_PASSWORD=changeme

# --- Required in development ------------------------------------------------------
# Production ignores this: compose.prod.yaml builds the URL from POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB so the app and the database cannot disagree.
TALAIA_DATABASE_URL=postgresql+asyncpg://talaia:changeme@db:5432/talaia

# --- Optional, shown with their defaults -------------------------------------------
# Which monitor file to load. The production default is config/monitors.local.yaml,
# which suits a git checkout on the host; if you deployed from a release bundle, name
# your own file here instead.
# TALAIA_CONFIG_PATH=/app/config/monitors.yaml
TALAIA_LOG_LEVEL=INFO
TALAIA_LOG_FORMAT=json            # json | console
TALAIA_RETENTION_DAYS=30

# Notifications. Leave TALAIA_NTFY_TOPIC empty to disable them.
TALAIA_NTFY_URL=https://ntfy.example.org
TALAIA_NTFY_TOPIC=
TALAIA_NTFY_TOKEN=

# Sessions. Create users with: python -m talaia.auth add <username>
TALAIA_SESSION_TTL_HOURS=720
# Leave unset: the cookie is Secure when TALAIA_BASE_URL is https:// and not otherwise.
# Set true or false only to override that.
# TALAIA_SESSION_COOKIE_SECURE=
# Send a low-priority notification on startup, so every deploy proves the phone still
# gets messages without you having to break a service to find out.
TALAIA_NOTIFY_ON_STARTUP=true

# IANA timezone for times shown in the UI, notifications and the CLI, e.g. Europe/Madrid.
# Unset means UTC. Storage is always UTC either way.
TALAIA_TIMEZONE=

# Bearer token accepted instead of a session cookie on /api routes, for scripts and CI.
# Unset, the API is reachable only with a login.
TALAIA_API_TOKEN=

# Bearer token required to scrape /metrics. Unset, the endpoint is open -- which is fine
# on a LAN that Prometheus and nothing else can reach, and not fine otherwise.
TALAIA_METRICS_TOKEN=

# Failed logins allowed from one address before attempts are refused. The lockout starts
# at TALAIA_LOGIN_LOCKOUT_SECONDS and doubles with each further failure, up to the maximum.
TALAIA_LOGIN_MAX_ATTEMPTS=5
TALAIA_LOGIN_LOCKOUT_SECONDS=60
TALAIA_LOGIN_MAX_LOCKOUT_SECONDS=900

# Reverse proxies whose X-Forwarded-* headers to trust, comma-separated, or * for any.
# Unset, only 127.0.0.1 is trusted -- a proxy on another host must be listed here or
# every request appears to come from the proxy.
TALAIA_PROXY_IPS=

# Optional. When set, the dashboard shows a Grafana link in its top bar.
TALAIA_GRAFANA_URL=

TALAIA_BASE_URL=http://localhost:9999

# Reported by the talaia_build_info metric. Set from the build argument of the same name.
TALAIA_COMMIT=unknown

# --- Backups -----------------------------------------------------------------------
# Where dumps land on the host, how long they are kept, and how often they are taken.
TALAIA_BACKUP_DIR=./backups
TALAIA_BACKUP_KEEP_DAYS=14
TALAIA_BACKUP_EVERY_SECONDS=86400

# --- Consumed by the postgres container, not by the application --------------------
POSTGRES_USER=talaia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talaia
