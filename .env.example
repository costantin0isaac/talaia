# Copy to .env and adjust. Never commit .env.

# --- Required ---------------------------------------------------------------------
TALAIA_DATABASE_URL=postgresql+asyncpg://talaia:changeme@db:5432/talaia

# --- Optional, shown with their defaults -------------------------------------------
TALAIA_CONFIG_PATH=/app/config/monitors.yaml
TALAIA_LOG_LEVEL=INFO
TALAIA_LOG_FORMAT=json            # json | console
TALAIA_RETENTION_DAYS=30

# Notifications. Leave TALAIA_NTFY_TOPIC empty to disable them.
TALAIA_NTFY_URL=https://ntfy.example.org
TALAIA_NTFY_TOPIC=
TALAIA_NTFY_TOKEN=

TALAIA_BASE_URL=http://localhost:9999

# --- Consumed by the postgres container, not by the application --------------------
POSTGRES_USER=talaia
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talaia
