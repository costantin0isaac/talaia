      },
      {
        "name": "monitor",
        "label": "Monitor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(talaia_check_up{group=~\"$group\"}, monitor)",
        "query": {
          "query": "label_values(talaia_check_up{group=~\"$group\"}, monitor)",
          "refId": "monitor"
        },
        "current": {},
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": [],
        "skipUrlSync": false
      }
    ]
  }
}
